@baseUrl = http://localhost:5037
@ruleId = 1

### Execute a draft without saving it (200). Requires database/05_rule_reader.sql.
POST {{baseUrl}}/api/rules/execute?limit=100
Content-Type: application/json

{
  "definition": {
    "name": "עובדים פעילים במחלקה לא פעילה",
    "description": "הרצה לניסיון, ללא שמירה",
    "rootEntityId": "employee",
    "resultFields": [
      {
        "fieldId": "firstName"
      },
      {
        "fieldId": "lastName"
      },
      {
        "fieldId": "name",
        "relationshipPath": [
          "employeeDepartment"
        ]
      },
      {
        "fieldId": "isActive",
        "relationshipPath": [
          "employeeDepartment"
        ]
      }
    ],
    "condition": {
      "kind": "group",
      "operator": "and",
      "children": [
        {
          "kind": "comparison",
          "left": {
            "fieldId": "isActive"
          },
          "operator": "equals",
          "right": {
            "kind": "constant",
            "value": true
          }
        },
        {
          "kind": "comparison",
          "left": {
            "fieldId": "isActive",
            "relationshipPath": [
              "employeeDepartment"
            ]
          },
          "operator": "equals",
          "right": {
            "kind": "constant",
            "value": false
          }
        }
      ]
    }
  }
}

### Execute the saved definition; edit ruleId above. Does not use unsaved editor changes.
POST {{baseUrl}}/api/rules/{{ruleId}}/execute?limit=100

### Missing start date, without saving (200)
POST {{baseUrl}}/api/rules/execute
Content-Type: application/json

{
  "definition": {
    "name": "תאריך תחילת העסקה חסר",
    "rootEntityId": "employee",
    "condition": {
      "kind": "comparison",
      "left": {
        "fieldId": "startDate"
      },
      "operator": "isNull"
    }
  }
}

### Salary reason includes the actual salary, while visible columns contain only the name.
POST {{baseUrl}}/api/rules/execute
Content-Type: application/json

{
  "definition": {
    "name": "שכר מעל הסף",
    "rootEntityId": "employee",
    "resultFields": [
      {
        "fieldId": "firstName"
      }
    ],
    "condition": {
      "kind": "comparison",
      "left": {
        "fieldId": "salary"
      },
      "operator": "greaterThan",
      "right": {
        "kind": "constant",
        "value": 15000
      }
    }
  }
}
