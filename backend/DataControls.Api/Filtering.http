@baseUrl = http://localhost:5037
@ruleId = 1

### Draft: violations in Sales, salary above 12,000. Options are never saved.
POST {{baseUrl}}/api/rules/execute?limit=100
Content-Type: application/json

{
  "definition": {
    "name": "עובדים פעילים במחלקה לא פעילה",
    "rootEntityId": "employee",
    "condition": {
      "kind": "group",
      "operator": "and",
      "children": [
        {
          "kind": "comparison",
          "left": {
            "fieldId": "isActive"
          },
          "operator": "equals",
          "right": {
            "kind": "constant",
            "value": true
          }
        },
        {
          "kind": "comparison",
          "left": {
            "fieldId": "isActive",
            "relationshipPath": [
              "employeeDepartment"
            ]
          },
          "operator": "equals",
          "right": {
            "kind": "constant",
            "value": false
          }
        }
      ]
    }
  },
  "options": {
    "search": "Sales",
    "filter": {
      "kind": "comparison",
      "left": {
        "fieldId": "salary"
      },
      "operator": "greaterThan",
      "right": {
        "kind": "constant",
        "value": 12000
      }
    }
  }
}

### Saved: use the saved definition and apply transient search/filter. Set ruleId above.
POST {{baseUrl}}/api/rules/{{ruleId}}/execute?limit=100
Content-Type: application/json

{
  "options": {
    "search": "Roni",
    "filter": {
      "kind": "comparison",
      "left": {
        "fieldId": "salary"
      },
      "operator": "greaterThan",
      "right": {
        "kind": "constant",
        "value": 20000
      }
    }
  }
}

### Draft: active employees with missing department name in the results.
POST {{baseUrl}}/api/rules/execute
Content-Type: application/json

{
  "definition": {
    "name": "עובדים פעילים",
    "rootEntityId": "employee",
    "condition": {
      "kind": "comparison",
      "left": {
        "fieldId": "isActive"
      },
      "operator": "equals",
      "right": {
        "kind": "constant",
        "value": true
      }
    }
  },
  "options": {
    "filter": {
      "kind": "comparison",
      "left": {
        "fieldId": "name",
        "relationshipPath": [
          "employeeDepartment"
        ]
      },
      "operator": "isNull"
    }
  }
}
